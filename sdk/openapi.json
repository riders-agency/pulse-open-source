          "client_id": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "billable": {
            "type": "boolean"
          }
        },
        "required": [
          "project_id",
          "title"
        ]
      },
      "TaskPatch": {
        "type": "object",

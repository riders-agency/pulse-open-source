# Browser requests stay same-origin; provider credentials never belong here.
NEXT_PUBLIC_RP_API_URL=

# Local Next.js proxy to the Go API. Leave unset behind the production proxy.
RP_API_PROXY_URL=http://127.0.0.1:9820

# Enable only on an isolated demo installation with the API demo policy enabled.
PULSE_PUBLIC_DEMO=false
# Optional external demo page for the login button on a normal installation.
# PULSE_PUBLIC_DEMO_URL=https://demo.example.test/demo

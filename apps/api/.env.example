# Только локальная разработка. Запуск из корня репозитория.
HTTP_ADDR=127.0.0.1:9820
DATABASE_URL=postgres://pulse:pulse@127.0.0.1:55432/pulse?sslmode=disable
MIGRATIONS_PATH=db/migrations
PULSE_RUNTIME_TOPOLOGY=split-worker
PULSE_TOOL_GRPC_ADDR=127.0.0.1:9098
PULSE_MODEL_GRPC_ADDR=127.0.0.1:9099

# Сгенерируйте собственный ключ: openssl rand -hex 32.
# Одинаковое значение требуется API и worker. Не коммитьте рабочие значения.
RIDERS_PULSE_MASTER_KEY=

# Для gRPC с Python задайте одинаковый случайный токен в обоих процессах.
# AI_AGENT_SERVICE_TOKEN=
# AI_AGENT_GRPC_ADDR=127.0.0.1:9097
